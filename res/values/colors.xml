<?xml version="1.0" encoding="utf-8"?>
<!--
  GhostWire palette — coral accent on cream (light) / dark. This file holds the
  LIGHT (cream) values; res/values-night/colors.xml holds the dark ones. The app
  defaults to dark (MainActivity forces night mode); cream is the light variant.
  Rebranding = change gw_accent here and in values-night.
-->
<resources>
    <color name="gw_accent">#F0502E</color>
    <color name="gw_primary">#F0502E</color>
    <color name="gw_primary_dark">#C63F20</color>
    <color name="gw_on_primary">#FFFFFF</color>
    <color name="gw_bg">#F5F0E8</color>
    <color name="gw_surface">#FFFFFF</color>
    <color name="gw_on_surface">#1C1E22</color>
    <color name="gw_muted">#6B6B6B</color>
</resources>
