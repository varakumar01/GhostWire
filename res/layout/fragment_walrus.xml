<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contactless Lab"
        style="@style/GhostWire.Header" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/GhostWire.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RFID/NFC card reading and cloning research, built on Walrus. Full in-app tooling is in progress."
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/walrus_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/walrus_launch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Walrus" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
